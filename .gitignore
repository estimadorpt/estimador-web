# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
dist/

# playwright MCP
.playwright-mcp/

# review screenshots — these pile up at the repo root during design reviews
*.png
# ...but the share cards are published assets, written here by the model repo's
# scripts/publish_cards.py. They must stay tracked.
!public/images/cards/*.png
snapshot-*.md
