  {
   "id": "ine_0010033",
   "title": "INE - Valor mediano das vendas de alojamentos familiares nos últimos 12 meses (Metodologia 2018 - €/m²) por Localização geográfica e Categoria do alojamento familiar; Anual (Estatísticas de preços da habitação ao nível local)",
   "url": "https://www.ine.pt/xurl/ind/0010033",
   "api_url": "https://www.ine.pt/ine/json_indicador/pindica.jsp?op=2&varcd=0010033&lang=PT&Dim1=S7A2016&Dim3=H1",
   "period": "2016-2020 (annual = 12 months ending Q4); used for 2016-2018",
   "notes": "Category H1 = Total (new + existing). Geo codes 1701106xx (NUTS 2013). Last updated 2021-06-14. Discontinued series; INE points to the 2019+ series (Metodologia 2022)."
  },
  {
   "id": "ine_0012255",
   "title": "INE - Valor mediano das vendas de alojamentos familiares (Metodologia 2022 - €/m²) por Localização geográfica (NUTS - 2024) e Categoria do alojamento familiar; Anual",
   "url": "https://www.ine.pt/xurl/ind/0012255",
   "api_url": "https://www.ine.pt/ine/json_indicador/pindica.jsp?op=2&varcd=0012255&lang=PT&Dim1=S7A2025&Dim3=H1",
   "period": "2019-2025 (calendar year); used for 2019-2025",
   "notes": "Category H1 = Total. Geo codes 1A01106xx (NUTS 2024). Last updated 2026-04-24. Annual values verified identical to the Q4 rolling-12-month values of quarterly indicator 0012234."
  },
  {
   "id": "ine_0012234",
   "title": "INE - Valor mediano das vendas de alojamentos familiares nos últimos 12 meses (Metodologia 2022 - €/m²) por Localização geográfica (NUTS - 2024) e Categoria do alojamento familiar; Trimestral",
   "url": "https://www.ine.pt/xurl/ind/0012234",
   "api_url": "https://www.ine.pt/ine/json_indicador/pindica.jsp?op=2&varcd=0012234&lang=PT&Dim1=S5A20261&Dim3=H1",
   "period": "12 months ending Q1 2026 (Apr 2025 - Mar 2026)",
   "notes": "Latest available (updated 2026-07-17). Used only for sale_eur_m2_12m_to_2026Q1; full-year 2026 not yet published."
  },
  {
   "id": "ine_0009631",
   "title": "INE - Valor mediano das rendas de novos contratos de arrendamento de alojamentos familiares (Metodologia 2021 - €/m²) por Localização geográfica (NUTS - 2013); Anual (Estatísticas de Rendas da Habitação ao nível local)",
   "url": "https://www.ine.pt/xurl/ind/0009631",
   "api_url": "https://www.ine.pt/ine/json_indicador/pindica.jsp?op=2&varcd=0009631&lang=PT&Dim1=S7A2017",
   "period": "2017-2023; used for 2017-2019",
   "notes": "Last updated 2024-03-28. Discontinued; INE points to new series 0014698 (from 2020). Series starts 2017, so no 2016 rent value exists."
  },
  {
   "id": "ine_0014698",
   "title": "INE - Valor mediano das rendas de novos contratos de arrendamento de alojamentos familiares (Metodologia 2026 - €/m²) por Localização geográfica (NUTS - 2024); Anual",
   "url": "https://www.ine.pt/xurl/ind/0014698",
   "api_url": "https://www.ine.pt/ine/json_indicador/pindica.jsp?op=2&varcd=0014698&lang=PT&Dim1=S7A2025",
   "period": "2020-2025; used for 2020-2025",
   "notes": "Last updated 2026-09-29 (INE note: 2020-2025 series revised on 29 Sep 2026 after a correction with slight changes in some NUTS III). A sibling indicator 0014773 (geografia 2025, updated 2026-06-26, pre-revision) differs by at most ~0.04 EUR/m2 for Lisbon parishes. Annual 2025 verified identical to Q4-2025 rolling-12-month value of 0014696."
  },
  {
   "id": "ine_0014696",
   "title": "INE - Valor mediano das rendas de novos contratos de arrendamento de alojamentos familiares nos últimos 12 meses (Metodologia 2026 - €/m²) por Localização geográfica (NUTS - 2024); Trimestral",
   "url": "https://www.ine.pt/xurl/ind/0014696",
   "api_url": "https://www.ine.pt/ine/json_indicador/pindica.jsp?op=2&varcd=0014696&lang=PT&Dim1=S5A20262",
   "period": "12 months ending Q2 2026 (Jul 2025 - Jun 2026)",
   "notes": "Latest available (updated 2026-09-29). Used only for rent_eur_m2_12m_to_2026Q2."
  },
  {
   "id": "ine_0011748",
   "title": "INE - Índice de custo de construção de habitação nova (Base 2021) por Fator de produção; Mensal",
   "url": "https://www.ine.pt/xurl/ind/0011748",
   "api_url": "https://www.ine.pt/ine/json_indicador/pindica.jsp?op=2&varcd=0011748&lang=PT&Dim1=T&Dim2=PT&Dim3=T",
   "period": "Monthly Jan 2000 - Aug 2026; annual = simple mean of 12 monthly indices",
   "notes": "Fator de produção = Total (materials + labour), Portugal, base 2021 = 100 (2021 mean = 100.00, consistent). Cross-checked against INE annual average rate of change (0011751, December values): 2016 1.2, 2017 1.8, 2018 2.3, 2019 2.3, 2020 2.1, 2021 6.5, 2022 12.2, 2023 3.9, 2024 3.3, 2025 4.0 % - all match the computed averages. Last updated 2026-10-09."
  },
  {
   "id": "ecb_euribor",
   "title": "ECB Data Portal - FM dataset: Euribor 1-year (FM.A.U2.EUR.RT.MM.EURIBOR1YD_.HSTA) and 6-month (FM.A.U2.EUR.RT.MM.EURIBOR6MD_.HSTA), historical close, average of observations through period",
   "url": "https://data-api.ecb.europa.eu/service/data/FM/A.U2.EUR.RT.MM.EURIBOR1YD_.HSTA?format=csvdata",
   "period": "Annual 2015-2025; 2026 = mean of monthly averages Jan-Sep 2026",
   "notes": "Data provided to ECB by Refinitiv. Percent per annum. 6-month: https://data-api.ecb.europa.eu/service/data/FM/A.U2.EUR.RT.MM.EURIBOR6MD_.HSTA?format=csvdata ; monthly series same keys with M. instead of A."
  },
  {
   "id": "rnal_webservice",
   "title": "Turismo de Portugal - Registo Nacional de Alojamento Local (RNAL), web service list_RNAL filtered to Concelho=Lisboa (linked from Lisboa Aberta dataset \"Alojamento Local - Registo Nacional\")",
   "url": "https://webservices.turismodeportugal.pt/RNT_External/rest/RNT/list_RNAL?Concelho=Lisboa",
   "period": "Snapshot downloaded 2026-10-10; latest DataRegisto in the file 2026-10-07",
   "notes": "11,863 records, counted by the DTMNFR (parish code) field of each record. Only aggregate counts were kept (records contain personal data of operators). Consistent with press: ~19,000 registrations before CML ordered cancellation of 6,765 (ECO, 2026-06-11, https://eco.sapo.pt/2026/06/11/mais-de-dez-mil-alojamentos-locais-encerrados-pelos-municipios/)."
  },
  {
   "id": "ine_0012501",
   "title": "INE Censos 2021 - Alojamentos familiares clássicos (N.º) por Localização geográfica à data dos Censos [2021] (NUTS - 2024), Forma de ocupação e Época de construção",
   "url": "https://www.ine.pt/xurl/ind/0012501",
   "api_url": "https://www.ine.pt/ine/json_indicador/pindica.jsp?op=2&varcd=0012501&lang=PT&Dim1=S7A2021&Dim2=1106&Dim3=T&Dim4=T",
   "period": "Census 2021",
   "notes": "Denominator for the AL ratio (Forma de ocupação = Total, Época = Total). Lisboa total 319,640; of which residência habitual 242,044."
  },
  {
   "id": "cml_rmal_2025",
   "title": "Regulamento Municipal do Alojamento Local de Lisboa, 2.ª alteração (Aviso n.º 29926-A/2025/2, DR 2.ª série n.º 235/2025, Suplemento; Deliberação 570/AML/2025), as summarised by PLMJ Nota Informativa Dez. 2025",
   "url": "https://www.plmj.com/xms/files/03_Novidades_legislativas/2025/NI_Alteracoes_ao_RMAL.pdf",
   "period": "In force since 2025-12-06; cited ratios are CML monitoring figures at the time of approval (late 2025, before the 2026 cancellations)",
   "notes": "Ratio = AL establishments / fogos de habitação permanente, the latter defined as alojamentos familiares clássicos in the latest Census (art. text in Boletim Municipal 1619, 27 Feb 2025 draft: https://amensagem.pt/wp-content/uploads/2025/11/Proposta-alteracao-RMAL-Lisboa-2025.pdf). Final thresholds: absolute containment >= 10% (municipality, parish or bairro); relative containment >= 5% and < 10% (parish or bairro). The Feb 2025 draft had 5% / 2.5%. Cited parish ratios: Santa Maria Maior 66.9, Misericórdia 43.8, Santo António 25.1, São Vicente 16.1, Arroios 13.5, Estrela 10.8 (Avenidas Novas classified relative containment, ratio not given)."
  }
 ],
