{
  "platform": {
    "apiRuntime": "node:22"
  },
  "routes": [
    {
      "route": "/api/*",
      "headers": {
        "cache-control": "no-store"
      }
    },
    {
      "route": "/_next/static/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/favicon.ico",
      "headers": {
        "cache-control": "public, max-age=86400"
      }
    },
    {
      "route": "/og-image-pt.png",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/og-image-en.png",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/og-image-*.png",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/data/population/*",
      "headers": {
        "cache-control": "public, max-age=86400"
      }
    },
    {
      "route": "/pt/populacao/freguesia/*",
      "rewrite": "/pt/populacao/freguesia/_/index.html"
    },
    {
      "route": "/en/populacao/freguesia/*",
      "rewrite": "/en/populacao/freguesia/_/index.html"
    },
    {
      "route": "/populacao/v/*",
      "rewrite": "/pt/populacao/consulta/index.html"
    },
    {
      "route": "/forecast",
      "redirect": "/pt/eleicoes/legislativas/",
      "statusCode": 301
    },
    {
      "route": "/pt/forecast",
      "redirect": "/pt/eleicoes/legislativas/",
      "statusCode": 301
    },
    {
      "route": "/en/forecast",
      "redirect": "/en/eleicoes/legislativas/",
      "statusCode": 301
    },
    {
      "route": "/about",
      "redirect": "/pt/sobre/",
      "statusCode": 301
    },
    {
      "route": "/pt/about",
      "redirect": "/pt/sobre/",
      "statusCode": 301
    },
    {
      "route": "/en/about",
      "redirect": "/en/sobre/",
      "statusCode": 301
    },
    {
      "route": "/methodology",
      "redirect": "/pt/metodologia/",
      "statusCode": 301
    },
    {
      "route": "/pt/methodology",
      "redirect": "/pt/metodologia/",
      "statusCode": 301
    },
    {
      "route": "/en/methodology",
      "redirect": "/en/metodologia/",
      "statusCode": 301
    },
    {
      "route": "/map",
      "redirect": "/pt/eleicoes/legislativas/mapa/",
      "statusCode": 301
    },
    {
      "route": "/pt/map",
      "redirect": "/pt/eleicoes/legislativas/mapa/",
      "statusCode": 301
    },
    {
      "route": "/en/map",
      "redirect": "/en/eleicoes/legislativas/mapa/",
      "statusCode": 301
    },
    {
      "route": "/pt/eleicoes/mapa",
      "redirect": "/pt/eleicoes/legislativas/mapa/",
      "statusCode": 301
    },
    {
      "route": "/en/eleicoes/mapa",
      "redirect": "/en/eleicoes/legislativas/mapa/",
      "statusCode": 301
    },
    {
      "route": "/articles",
      "redirect": "/pt/artigos/",
      "statusCode": 301
    },
    {
      "route": "/pt/articles",
      "redirect": "/pt/artigos/",
      "statusCode": 301
    },
    {
      "route": "/en/articles",
      "redirect": "/en/artigos/",
      "statusCode": 301
    },
    {
      "route": "/desporto",
      "redirect": "/pt/desporto/liga/",
      "statusCode": 301
    },
    {
      "route": "/desporto/liga",
      "redirect": "/pt/desporto/liga/",
      "statusCode": 301
    },
    {
      "route": "/economia",
      "redirect": "/pt/economia/",
      "statusCode": 301
    },
    {
      "route": "/eleicoes",
      "redirect": "/pt/eleicoes/arquivo/",
      "statusCode": 301
    },
    {
      "route": "/eleicoes/arquivo",
      "redirect": "/pt/eleicoes/arquivo/",
      "statusCode": 301
    },
    {
      "route": "/eleicoes/presidenciais",
      "redirect": "/pt/eleicoes/presidenciais/",
      "statusCode": 301
    },
    {
      "route": "/eleicoes/legislativas",
      "redirect": "/pt/eleicoes/legislativas/",
      "statusCode": 301
    },
    {
      "route": "/eleicoes/legislativas/mapa",
      "redirect": "/pt/eleicoes/legislativas/mapa/",
      "statusCode": 301
    },
    {
      "route": "/populacao",
      "redirect": "/pt/populacao/",
      "statusCode": 301
    },
    {
      "route": "/sobre",
      "redirect": "/pt/sobre/",
      "statusCode": 301
    },
    {
      "route": "/artigos",
      "redirect": "/pt/artigos/",
      "statusCode": 301
    },
    {
      "route": "/metodologia",
      "redirect": "/pt/metodologia/",
      "statusCode": 301
    },
    {
      "route": "/privacidade",
      "redirect": "/pt/privacidade/",
      "statusCode": 301
    },
    {
      "route": "/pt/desporto",
      "redirect": "/pt/desporto/liga/",
      "statusCode": 301
    },
    {
      "route": "/en/desporto",
      "redirect": "/en/desporto/liga/",
      "statusCode": 301
    },
    {
      "route": "/pt/eleicoes",
      "redirect": "/pt/eleicoes/arquivo/",
      "statusCode": 301
    },
    {
      "route": "/en/eleicoes",
      "redirect": "/en/eleicoes/arquivo/",
      "statusCode": 301
    },
    {
      "route": "/feed.xml",
      "redirect": "/pt/feed.xml",
      "statusCode": 301
    },
    {
      "route": "/",
      "redirect": "/pt/",
      "statusCode": 301
    }
  ],
  "mimeTypes": {
    ".json": "application/json",
    ".txt": "text/plain",
    ".wasm": "application/wasm",
    ".parquet": "application/vnd.apache.parquet",
    ".xml": "application/xml",
    ".avif": "image/avif"
  },
  "globalHeaders": {
    "cache-control": "public, max-age=0, must-revalidate"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "trailingSlash": "auto"
}
